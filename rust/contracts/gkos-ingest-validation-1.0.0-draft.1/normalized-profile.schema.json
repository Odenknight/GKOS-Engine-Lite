{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Odenknight/GKOS-Engine/contracts/ingest/gkos-ingest-validation-1.0.0-draft.1/normalized-profile.schema.json",
  "title": "GKOS normalized effective ingest profile draft 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "profile_id", "standard_commit", "standard_frontmatter_schema_sha256",
    "standard_common_defs_sha256", "standard_diagnostics_sha256", "engine_projection_profile",
    "engine_policy_id", "engine_policy_hash", "required_fields", "unknown_fields",
    "minimum_sensitivity", "identity_rules", "relationship_rules", "severity", "fields"
  ],
  "properties": {
    "contract_version": { "const": "gkos-frontmatter-profile-effective/1.0.0-draft.1" },
    "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "standard_commit": { "const": "a2a2a6ca5c4dac32c6d9dc985ed7460f5f4350c6" },
    "standard_frontmatter_schema_sha256": { "const": "sha256:eb25f75b4864a9130b2e27bdba2627e561fc79ab3a2537397bf5df024aab5ca3" },
    "standard_common_defs_sha256": { "const": "sha256:5b58edd93a53f6b821bfc03e2e4e3955da394bfaccb72e3ff194b45115c44c98" },
    "standard_diagnostics_sha256": { "const": "sha256:178e4801d1274da60fe029d3f326b9adbdbf0e2a2033469928022fa107427403" },
    "engine_projection_profile": { "const": "gkx-2.3-validating-projection" },
    "engine_policy_id": { "const": "policy:gkx23-default-v1" },
    "engine_policy_hash": { "const": "sha256:2c2d8ec1e6481cbd4476bcc544c4fd19be03d8f21e317e44d889ea46e940ec8b" },
    "required_fields": {
      "type": "array", "minItems": 6, "maxItems": 256, "uniqueItems": true,
      "items": { "allOf": [{ "$ref": "#/$defs/fieldId" }, { "not": { "const": "sensitivity" } }] },
      "allOf": [
        { "contains": { "const": "created_at" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "epistemic_state" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "gkx_version" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "title" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "type" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "const": "uid" }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "unknown_fields": { "enum": ["allow", "warn", "reject"] },
    "minimum_sensitivity": { "$ref": "#/$defs/sensitivity" },
    "identity_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["stable_authored_uid_required", "uid_syntax_authority", "path_is_identity", "duplicate_uid_or_path", "identity_mutation_or_defaulting"],
      "properties": {
        "stable_authored_uid_required": { "const": true },
        "uid_syntax_authority": { "const": "canonical_gkx_parser" },
        "path_is_identity": { "const": false },
        "duplicate_uid_or_path": { "const": "cross_record_report_only" },
        "identity_mutation_or_defaulting": { "const": false }
      }
    },
    "relationship_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["declaration_syntax_authority", "malformed_authored_reference", "endpoint_resolution_and_topology", "ordinary_markdown_or_wikilink_unresolved", "second_resolution_pass"],
      "properties": {
        "declaration_syntax_authority": { "const": "canonical_gkx_parser_receipts" },
        "malformed_authored_reference": { "const": "intrinsic" },
        "endpoint_resolution_and_topology": { "const": "cross_record_report_only" },
        "ordinary_markdown_or_wikilink_unresolved": { "const": "non_conflicting" },
        "second_resolution_pass": { "const": false }
      }
    },
    "severity": {
      "type": "array", "minItems": 16, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "#/$defs/severityRule" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-AUTHORITY-ROLE-001" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-AUTHORITY-ROLE-002" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-EPISTEMIC-002" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-EPISTEMIC-004" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-EVIDENCE-002" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-EVIDENCE-003" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-IDENTITY-001" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-IDENTITY-002" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-PROVENANCE-001" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-PROVENANCE-002" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-SCHEMA-002" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-SCHEMA-003" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-SCHEMA-004" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-SENSITIVITY-001" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-SENSITIVITY-005" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "code": { "const": "GKX-TEMPORAL-001" } }, "required": ["code"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "fields": {
      "type": "array", "minItems": 11, "maxItems": 256, "uniqueItems": true,
      "items": { "$ref": "#/$defs/fieldRule" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "field": { "const": "aliases" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "authorship_origin" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "created_at" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "epistemic_state" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "gkx_version" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "sensitivity" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "tags" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "title" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "type" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "uid" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "field": { "const": "updated_at" } }, "required": ["field"] }, "minContains": 1, "maxContains": 1 }
      ]
    }
  },
  "$defs": {
    "fieldId": {
      "oneOf": [
        { "enum": ["aliases", "authorship_origin", "created_at", "epistemic_state", "gkx_version", "sensitivity", "tags", "title", "type", "uid", "updated_at"] },
        { "type": "string", "pattern": "^x-[a-z0-9][a-z0-9_-]{0,62}$" }
      ]
    },
    "severity": { "enum": ["info", "warning", "error", "critical"] },
    "sensitivity": { "enum": ["public", "internal", "restricted", "confidential", "regulated", "phi", "secret"] },
    "nullableLength": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 262144 }, { "type": "null" }] },
    "nullableIntegerBound": { "oneOf": [{ "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }, { "type": "null" }] },
    "nullableArrayBound": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 262144 }, { "type": "null" }] },
    "nullableEnum": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      ]
    },
    "baseFieldRule": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "type", "required", "min_length", "max_length", "integer_minimum", "integer_maximum", "array_max_items", "array_item_max_length", "enum", "extension"],
      "properties": {
        "field": { "$ref": "#/$defs/fieldId" },
        "type": { "enum": ["string", "boolean", "integer", "array<string>"] },
        "required": { "type": "boolean" },
        "min_length": { "$ref": "#/$defs/nullableLength" },
        "max_length": { "$ref": "#/$defs/nullableLength" },
        "integer_minimum": { "$ref": "#/$defs/nullableIntegerBound" },
        "integer_maximum": { "$ref": "#/$defs/nullableIntegerBound" },
        "array_max_items": { "$ref": "#/$defs/nullableArrayBound" },
        "array_item_max_length": { "$ref": "#/$defs/nullableArrayBound" },
        "enum": { "$ref": "#/$defs/nullableEnum" },
        "extension": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "type": { "const": "string" }, "required": { "const": true } }, "required": ["type", "required"] },
          "then": { "type": "object", "properties": { "max_length": { "type": "integer", "minimum": 1 } } }
        }
      ]
    },
    "stringField": {
      "allOf": [
        { "$ref": "#/$defs/baseFieldRule" },
        { "type": "object", "properties": {
          "type": { "const": "string" }, "max_length": { "type": "integer", "maximum": 262144 },
          "integer_minimum": { "type": "null" }, "integer_maximum": { "type": "null" },
          "array_max_items": { "type": "null" }, "array_item_max_length": { "type": "null" }, "extension": { "const": false }
        } }
      ]
    },
    "arrayField": {
      "allOf": [
        { "$ref": "#/$defs/baseFieldRule" },
        { "type": "object", "properties": {
          "type": { "const": "array<string>" }, "min_length": { "type": "null" }, "max_length": { "type": "null" },
          "integer_minimum": { "type": "null" }, "integer_maximum": { "type": "null" },
          "array_max_items": { "const": 262144 }, "array_item_max_length": { "const": 262144 },
          "enum": { "type": "null" }, "extension": { "const": false }
        } }
      ]
    },
    "fieldRule": {
      "oneOf": [
        { "allOf": [{ "$ref": "#/$defs/arrayField" }, { "type": "object", "properties": { "field": { "const": "aliases" } } }] },
        { "allOf": [{ "$ref": "#/$defs/stringField" }, { "type": "object", "properties": { "field": { "const": "authorship_origin" }, "enum": { "type": "array", "items": { "enum": ["authored", "derived", "proposed", "approved"] } } } }] },
        { "allOf": [{ "$ref": "#/$defs/stringField" }, { "type": "object", "properties": { "field": { "const": "created_at" }, "required": { "const": true } } }] },
        { "allOf": [{ "$ref": "#/$defs/stringField" }, { "type": "object", "properties": { "field": { "const": "epistemic_state" }, "required": { "const": true }, "enum": { "type": "array", "items": { "enum": ["unknown", "observation", "reported", "inferred", "hypothesis", "modeled", "supported", "contested", "refuted", "retracted", "accepted", "superseded"] } } } }] },
        { "allOf": [{ "$ref": "#/$defs/stringField" }, { "type": "object", "properties": { "field": { "const": "gkx_version" }, "required": { "const": true }, "enum": { "const": ["2.3"] } } }] },
        { "allOf": [{ "$ref": "#/$defs/stringField" }, { "type": "object", "properties": { "field": { "const": "sensitivity" }, "required": { "const": false }, "enum": { "type": "array", "items": { "$ref": "#/$defs/sensitivity" } } } }] },
        { "allOf": [{ "$ref": "#/$defs/arrayField" }, { "type": "object", "properties": { "field": { "const": "tags" } } }] },
        { "allOf": [{ "$ref": "#/$defs/stringField" }, { "type": "object", "properties": { "field": { "const": "title" }, "required": { "const": true }, "min_length": { "type": "integer", "minimum": 1 } } }] },
        { "allOf": [{ "$ref": "#/$defs/stringField" }, { "type": "object", "properties": { "field": { "const": "type" }, "required": { "const": true }, "min_length": { "type": "integer", "minimum": 1 } } }] },
        { "allOf": [{ "$ref": "#/$defs/stringField" }, { "type": "object", "properties": { "field": { "const": "uid" }, "required": { "const": true }, "min_length": { "type": "integer", "minimum": 1 } } }] },
        { "allOf": [{ "$ref": "#/$defs/stringField" }, { "type": "object", "properties": { "field": { "const": "updated_at" } } }] },
        {
          "allOf": [
            { "$ref": "#/$defs/baseFieldRule" },
            {
              "type": "object",
              "properties": { "field": { "type": "string", "pattern": "^x-[a-z0-9][a-z0-9_-]{0,62}$" }, "extension": { "const": true } },
              "allOf": [
                {
                  "if": { "type": "object", "properties": { "type": { "const": "string" } }, "required": ["type"] },
                  "then": { "type": "object", "properties": {
                    "max_length": { "type": "integer", "maximum": 262144 }, "integer_minimum": { "type": "null" },
                    "integer_maximum": { "type": "null" }, "array_max_items": { "type": "null" }, "array_item_max_length": { "type": "null" }
                  } },
                  "else": { "type": "object", "properties": { "min_length": { "type": "null" }, "max_length": { "type": "null" }, "enum": { "type": "null" } } }
                },
                {
                  "if": { "type": "object", "properties": { "type": { "const": "integer" } }, "required": ["type"] },
                  "then": { "type": "object", "properties": {
                    "integer_minimum": { "const": -2147483648 }, "integer_maximum": { "const": 2147483647 },
                    "array_max_items": { "type": "null" }, "array_item_max_length": { "type": "null" }
                  } },
                  "else": { "type": "object", "properties": { "integer_minimum": { "type": "null" }, "integer_maximum": { "type": "null" } } }
                },
                {
                  "if": { "type": "object", "properties": { "type": { "const": "array<string>" } }, "required": ["type"] },
                  "then": { "type": "object", "properties": { "array_max_items": { "const": 256 }, "array_item_max_length": { "const": 1024 } } },
                  "else": { "type": "object", "properties": { "array_max_items": { "type": "null" }, "array_item_max_length": { "type": "null" } } }
                }
              ]
            }
          ]
        }
      ]
    },
    "severityRule": {
      "oneOf": [
        { "$ref": "#/$defs/severityCritical" },
        { "allOf": [{ "$ref": "#/$defs/severityBase" }, { "type": "object", "properties": { "code": { "enum": ["GKX-AUTHORITY-ROLE-002", "GKX-EPISTEMIC-002", "GKX-EVIDENCE-002", "GKX-EVIDENCE-003", "GKX-IDENTITY-002", "GKX-PROVENANCE-002", "GKX-SCHEMA-004", "GKX-SENSITIVITY-005"] }, "severity": { "enum": ["error", "critical"] } } }] },
        { "allOf": [{ "$ref": "#/$defs/severityBase" }, { "type": "object", "properties": { "code": { "enum": ["GKX-EPISTEMIC-004", "GKX-IDENTITY-001", "GKX-PROVENANCE-001", "GKX-SCHEMA-003", "GKX-TEMPORAL-001"] }, "severity": { "enum": ["warning", "error", "critical"] } } }] },
        { "allOf": [{ "$ref": "#/$defs/severityBase" }, { "type": "object", "properties": { "code": { "const": "GKX-SENSITIVITY-001" }, "severity": { "const": "warning" } } }] },
        { "allOf": [{ "$ref": "#/$defs/severityBase" }, { "type": "object", "properties": { "code": { "const": "GKX-SCHEMA-002" }, "severity": { "$ref": "#/$defs/severity" } } }] }
      ]
    },
    "severityBase": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "severity"],
      "properties": { "code": { "type": "string" }, "severity": { "$ref": "#/$defs/severity" } }
    },
    "severityCritical": {
      "allOf": [{ "$ref": "#/$defs/severityBase" }, { "type": "object", "properties": { "code": { "const": "GKX-AUTHORITY-ROLE-001" }, "severity": { "const": "critical" } } }]
    }
  }
}
