{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkos.example/contracts/retrieval/gkos-retrieval-1.0.0-draft.2/projection.schema.json",
  "title": "GKOS retrieval projection manifest draft 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "projection_schema_version", "provenance_contract_version", "gkx_standard_commit", "gkx_projection_profile", "projection_id", "engine_version", "vault_id", "source_snapshot_digest", "configuration_digest", "policy_digest", "chunker_version", "tokenizer_version", "lexical_backend", "embedding_provider_id", "embedding_model_id", "embedding_dimensions", "candidate_source_count", "candidate_declaration_count", "represented_candidate_source_count", "candidate_chunk_count", "embedding_eligible_candidate_chunk_count", "projection_digest"],
  "properties": {
    "contract_version": { "const": "gkos-retrieval/1.0.0-draft.2" },
    "projection_schema_version": { "const": 3 },
    "provenance_contract_version": { "const": "gkos-retrieval-provenance/1.0.0-draft.1" },
    "gkx_standard_commit": { "const": "a2a2a6ca5c4dac32c6d9dc985ed7460f5f4350c6" },
    "gkx_projection_profile": { "const": "gkx-2.3-validating-projection" },
    "projection_id": { "type": "string", "pattern": "^retrieval:[0-9a-f]{24}$" },
    "engine_version": { "type": "string", "minLength": 1 },
    "vault_id": { "type": "string", "minLength": 1 },
    "source_snapshot_digest": { "$ref": "#/$defs/sha256" },
    "configuration_digest": { "$ref": "#/$defs/sha256" },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "chunker_version": { "const": "gkos-heading-chunker/1" },
    "tokenizer_version": { "const": "gkos-ascii-whitespace/1" },
    "lexical_backend": { "enum": ["sqlite_fts5", "sqlite_lexical_scan"] },
    "embedding_provider_id": { "type": ["string", "null"] },
    "embedding_model_id": { "type": ["string", "null"] },
    "embedding_dimensions": { "type": ["integer", "null"], "minimum": 1 },
    "candidate_source_count": { "type": "integer", "minimum": 0 },
    "candidate_declaration_count": { "type": "integer", "minimum": 0 },
    "represented_candidate_source_count": { "type": "integer", "minimum": 0 },
    "candidate_chunk_count": { "type": "integer", "minimum": 0 },
    "embedding_eligible_candidate_chunk_count": { "type": "integer", "minimum": 0 },
    "projection_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
