{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkos.example/contracts/retrieval/gkos-retrieval-evaluation-1.0.0-draft.1/evaluation-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "result", "source_observations", "audit_oracle", "expected_temporal"],
  "properties": {
    "query": { "$ref": "normalized-golden.schema.json#/$defs/query" },
    "result": { "$ref": "../gkos-retrieval-1.0.0-draft.2/result.schema.json" },
    "source_observations": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_path", "source_digest", "source_bytes_base64"],
        "properties": {
          "source_id": { "$ref": "common.schema.json#/$defs/uid" },
          "source_path": { "$ref": "common.schema.json#/$defs/sourcePath" },
          "source_digest": { "$ref": "common.schema.json#/$defs/sha256" },
          "source_bytes_base64": { "type": "string", "maxLength": 89478488, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
        }
      }
    },
    "audit_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "authorized_source_ids", "authorized_source_paths", "forbidden_source_ids", "forbidden_source_paths", "authorized_endpoint_ids", "forbidden_endpoint_ids", "expected_public_result_projection_id", "expected_public_result_projection_digest", "oracle_digest"],
      "properties": {
        "contract_version": { "const": "gkos-retrieval-evaluation-query-view-audit-oracle/1.0.0-draft.1" },
        "authorized_source_ids": { "type": "array", "maxItems": 4096, "items": { "$ref": "common.schema.json#/$defs/uid" }, "uniqueItems": true },
        "authorized_source_paths": { "type": "array", "maxItems": 4096, "items": { "$ref": "common.schema.json#/$defs/sourcePath" }, "uniqueItems": true },
        "forbidden_source_ids": { "type": "array", "maxItems": 4096, "items": { "$ref": "common.schema.json#/$defs/uid" }, "uniqueItems": true },
        "forbidden_source_paths": { "type": "array", "maxItems": 4096, "items": { "$ref": "common.schema.json#/$defs/sourcePath" }, "uniqueItems": true },
        "authorized_endpoint_ids": { "type": "array", "maxItems": 4096, "items": { "$ref": "common.schema.json#/$defs/uid" }, "uniqueItems": true },
        "forbidden_endpoint_ids": { "type": "array", "maxItems": 4096, "items": { "$ref": "common.schema.json#/$defs/uid" }, "uniqueItems": true },
        "expected_public_result_projection_id": { "type": "string", "pattern": "^retrieval:[0-9a-f]{24}$" },
        "expected_public_result_projection_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "oracle_digest": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    },
    "expected_temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "hits"],
      "properties": {
        "coverage": { "enum": ["not_requested", "not_evaluated", "sufficient", "insufficient"] },
        "hits": { "type": "array", "maxItems": 100, "items": { "$ref": "common.schema.json#/$defs/temporalProjection" } }
      }
    }
  }
}
