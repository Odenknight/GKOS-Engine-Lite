{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkos.example/contracts/retrieval/gkos-retrieval-evaluation-1.0.0-draft.1/metric-computation-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "cases", "fixture_digest"],
  "properties": {
    "contract_version": { "const": "gkos-retrieval-evaluation-metric-computation-fixture/1.0.0-draft.1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/case" }
    },
    "fixture_digest": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "coverage", "parity_group", "input_schema_valid", "expected_status", "input", "expected_metrics", "expected_code", "case_digest"],
      "properties": {
        "case_id": { "$ref": "common.schema.json#/$defs/evaluationId" },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/evaluationId" }
        },
        "parity_group": { "oneOf": [{ "$ref": "common.schema.json#/$defs/evaluationId" }, { "type": "null" }] },
        "input_schema_valid": { "type": "boolean" },
        "expected_status": { "enum": ["metrics", "error"] },
        "input": { "type": "object" },
        "expected_metrics": { "oneOf": [{ "$ref": "query-metrics.schema.json" }, { "type": "null" }] },
        "expected_code": { "oneOf": [{ "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }, { "type": "null" }] },
        "case_digest": { "$ref": "common.schema.json#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "expected_status": { "const": "metrics" } }, "required": ["expected_status"] },
          "then": {
            "type": "object",
            "properties": {
              "input_schema_valid": { "const": true },
              "input": { "$ref": "evaluation-input.schema.json" },
              "expected_metrics": { "$ref": "query-metrics.schema.json" },
              "expected_code": { "type": "null" }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "expected_metrics": { "type": "null" },
              "expected_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" }
            }
          }
        }
      ]
    }
  }
}
