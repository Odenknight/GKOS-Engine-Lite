{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkos.example/contracts/retrieval/gkos-retrieval-evaluation-1.0.0-draft.1/metrics-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "environment_set_digest", "normalized_golden_digest", "query_count", "query_evaluations", "query_metrics_set_digest", "environment_aggregates", "aggregate_metrics", "metrics_set_digest"],
  "properties": {
    "contract_version": { "const": "gkos-retrieval-evaluation-metrics-set/1.0.0-draft.1" },
    "environment_set_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "normalized_golden_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "query_count": { "type": "integer", "minimum": 1, "maximum": 256 },
    "query_evaluations": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/queryEvaluation" } },
    "query_metrics_set_digest": { "$ref": "common.schema.json#/$defs/sha256" },
    "environment_aggregates": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/environmentAggregate" } },
    "aggregate_metrics": { "$ref": "aggregate-metrics.schema.json" },
    "metrics_set_digest": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "queryEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_digest", "golden_query_digest", "query_metrics"],
      "properties": {
        "environment_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "golden_query_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "query_metrics": { "$ref": "query-metrics.schema.json" }
      }
    },
    "environmentAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_digest", "query_count", "query_metrics_set_digest", "aggregate_metrics", "environment_aggregate_digest"],
      "properties": {
        "environment_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "query_count": { "type": "integer", "minimum": 1, "maximum": 256 },
        "query_metrics_set_digest": { "$ref": "common.schema.json#/$defs/sha256" },
        "aggregate_metrics": { "$ref": "aggregate-metrics.schema.json" },
        "environment_aggregate_digest": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    }
  }
}
