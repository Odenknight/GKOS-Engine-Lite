{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkos.example/contracts/retrieval/gkos-retrieval-evaluation-1.0.0-draft.1/tune-priority-fixture.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "cases", "fixture_digest"],
  "properties": {
    "contract_version": { "const": "gkos-retrieval-evaluation-tune-priority-fixture/1.0.0-draft.1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/case" }
    },
    "fixture_digest": { "$ref": "common.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rrf_k", "mmr", "mmr_lambda_micros", "semantic_top_k", "lexical_top_k"],
      "properties": {
        "rrf_k": { "enum": [5, 10, 20, 30, 60, 100] },
        "mmr": { "type": "boolean" },
        "mmr_lambda_micros": { "enum": [null, 0, 300000, 500000, 700000, 1000000] },
        "semantic_top_k": { "enum": [5, 10, 20, 40, 80] },
        "lexical_top_k": { "enum": [5, 10, 20, 40, 80] }
      },
      "allOf": [
        {
          "if": { "type": "object", "properties": { "mmr": { "const": false } }, "required": ["mmr"] },
          "then": { "type": "object", "properties": { "mmr_lambda_micros": { "type": "null" } } },
          "else": { "type": "object", "properties": { "mmr_lambda_micros": { "type": "integer" } } }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "axes", "ndcg_at_k_micros", "recall_at_k_micros", "mrr_micros", "zero_gate_failures"],
      "properties": {
        "candidate_id": { "$ref": "common.schema.json#/$defs/evaluationId" },
        "axes": { "$ref": "#/$defs/axes" },
        "ndcg_at_k_micros": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "recall_at_k_micros": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "mrr_micros": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "zero_gate_failures": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["CITATION_COVERAGE", "CITATION_MISMATCH", "CONFIDENCE_MISMATCH", "POLICY_LEAK", "STALE_CITATION", "STALE_PROJECTION", "TEMPORAL_MISMATCH", "UNVERIFIED_PROJECTION"]
          }
        }
      }
    },
    "candidateIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/evaluationId" }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "baseline_axes", "baseline_ndcg_at_k_micros", "candidates", "expected_conforming_candidate_ids", "expected_ordered_candidate_ids", "expected_selected_candidate_id", "case_digest"],
      "properties": {
        "case_id": { "$ref": "common.schema.json#/$defs/evaluationId" },
        "baseline_axes": { "$ref": "#/$defs/axes" },
        "baseline_ndcg_at_k_micros": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "candidates": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/candidate" } },
        "expected_conforming_candidate_ids": { "$ref": "#/$defs/candidateIds" },
        "expected_ordered_candidate_ids": { "$ref": "#/$defs/candidateIds" },
        "expected_selected_candidate_id": {
          "oneOf": [{ "$ref": "common.schema.json#/$defs/evaluationId" }, { "type": "null" }]
        },
        "case_digest": { "$ref": "common.schema.json#/$defs/sha256" }
      }
    }
  }
}
